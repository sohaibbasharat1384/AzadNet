diff --git a/cli/azadnet_tls_test.go b/cli/azadnet_tls_test.go
new file mode 100644
--- /dev/null
+++ b/cli/azadnet_tls_test.go
@@ -0,0 +1,51 @@
+package cli
+
+import (
+	tls "github.com/refraction-networking/utls"
+	"testing"
+)
+
+func TestAzadNetRandomizedHybridShares(t *testing.T) {
+	for _, base := range []tls.ClientHelloID{tls.HelloRandomizedALPN, tls.HelloRandomizedNoALPN} {
+		hybrid := 0
+		for i := 0; i < 1000; i++ {
+			id := base
+			weights := tls.DefaultWeights
+			weights.CurveIDs_Append_X25519 = 1
+			weights.KeyShare_Append_RandomGroups = 1
+			id.Weights = &weights
+			spec, err := tls.UTLSIdToSpec(id)
+			if err != nil {
+				t.Fatal(err)
+			}
+			groups := map[tls.CurveID]bool{}
+			shares := map[tls.CurveID]bool{}
+			for _, ext := range spec.Extensions {
+				if v, ok := ext.(*tls.SupportedCurvesExtension); ok {
+					for _, g := range v.Curves {
+						groups[g] = true
+					}
+				}
+				if v, ok := ext.(*tls.KeyShareExtension); ok {
+					for _, s := range v.KeyShares {
+						shares[s.Group] = true
+					}
+				}
+			}
+			if groups[tls.X25519MLKEM768] {
+				hybrid++
+				if !shares[tls.X25519MLKEM768] {
+					t.Fatal("hybrid group without initial key share")
+				}
+			}
+			for g := range shares {
+				if !groups[g] {
+					t.Fatal("key share without advertised group")
+				}
+			}
+		}
+		if hybrid == 0 {
+			t.Fatal("test never covered TLS 1.3 hybrid")
+		}
+	}
+}
