diff --git a/transport/openvpn/peer_identity_test.go b/transport/openvpn/peer_identity_test.go
new file mode 100644
index 00000000..164942b9
--- /dev/null
+++ b/transport/openvpn/peer_identity_test.go
@@ -0,0 +1,68 @@
+package openvpn
+
+import (
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"github.com/metacubex/tls"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/pem"
+	"math/big"
+	"testing"
+	"time"
+)
+
+func identityFixture(t *testing.T, name string) ([]byte, *x509.Certificate) {
+	t.Helper()
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	now := time.Now()
+	ca := &x509.Certificate{SerialNumber: big.NewInt(1), Subject: pkix.Name{CommonName: "AzadNet local test CA"}, NotBefore: now.Add(-time.Hour), NotAfter: now.Add(time.Hour), IsCA: true, BasicConstraintsValid: true, KeyUsage: x509.KeyUsageCertSign}
+	caDER, err := x509.CreateCertificate(rand.Reader, ca, ca, &key.PublicKey, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	parsedCA, err := x509.ParseCertificate(caDER)
+	if err != nil {
+		t.Fatal(err)
+	}
+	leaf := &x509.Certificate{SerialNumber: big.NewInt(2), Subject: pkix.Name{CommonName: name}, NotBefore: now.Add(-time.Hour), NotAfter: now.Add(time.Hour), KeyUsage: x509.KeyUsageDigitalSignature, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}}
+	leafDER, err := x509.CreateCertificate(rand.Reader, leaf, parsedCA, &key.PublicKey, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	parsedLeaf, err := x509.ParseCertificate(leafDER)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: caDER}), parsedLeaf
+}
+func TestOpenVPNPeerIdentity(t *testing.T) {
+	ca, leaf := identityFixture(t, "windscribe-local-test")
+	for _, tc := range []struct {
+		name, kind string
+		ok         bool
+	}{{"windscribe-local-test", "name", true}, {"wrong-peer", "name", false}, {"windscribe-", "name-prefix", true}, {"wrong-", "name-prefix", false}} {
+		client := &Client{config: &ClientConfig{CA: ca, VerifyX509Name: tc.name, VerifyX509NameType: tc.kind}}
+		cfg, err := client.tlsConfig()
+		if err != nil {
+			t.Fatal(err)
+		}
+		err = cfg.VerifyConnection(tls.ConnectionState{PeerCertificates: []*x509.Certificate{leaf}})
+		if (err == nil) != tc.ok {
+			t.Fatalf("identity check %s/%s: %v", tc.name, tc.kind, err)
+		}
+	}
+	otherCA, _ := identityFixture(t, "untrusted-ca")
+	client := &Client{config: &ClientConfig{CA: otherCA, VerifyX509Name: "windscribe-local-test", VerifyX509NameType: "name"}}
+	cfg, err := client.tlsConfig()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cfg.VerifyConnection(tls.ConnectionState{PeerCertificates: []*x509.Certificate{leaf}}) == nil {
+		t.Fatal("matching name bypassed CA validation")
+	}
+}
